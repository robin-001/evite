# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=events.angstrom-technologies.ug

# --- Database (leave unset to use SQLite for local dev) ---
MYSQL_NAME=evite
MYSQL_USER=evite
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Kenkom SMS ---
KENKOM_BASE_URL=https://pay.kenkom.ug
KENKOM_API_KEY=
KENKOM_SENDER=ANGSTROM
# false = dry-run (messages logged, nothing sent)
SEND_SMS=false

# --- Google sign-in ---
# Create an OAuth "Web" client ID at https://console.cloud.google.com/apis/credentials
# Authorised JS origin: https://events.angstrom-technologies.ug
GOOGLE_CLIENT_ID=
# Frontend build var (same value)
VITE_GOOGLE_CLIENT_ID=

# --- Public URLs ---
PUBLIC_BASE_URL=https://events.angstrom-technologies.ug
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN=60

# Dev-only (vite proxy needs this when not serving same-origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
